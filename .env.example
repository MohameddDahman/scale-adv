# Written for you by `npx convex dev` (development) — don't edit by hand.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Where HTTP routes live (CV uploads). Optional: derived from NEXT_PUBLIC_CONVEX_URL when empty.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public address of the website, used for canonical links, the sitemap and
# structured data. Set this in production, e.g. https://scale-adv.com
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Set on the Convex deployment (not in this file):
#   npx convex env set SETUP_KEY <long-random-string>
# When SETUP_KEY is set, /admin/setup asks for it before creating the owner
# account. Recommended for production so nobody else can claim the dashboard.
#
#   npx convex env set CLOUDINARY_URL "cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Turns on video uploads (reels are stored on Cloudinary, never in Convex).
# Copy it from the Cloudinary console: Settings → API Keys. Add --prod for live.
# ---------------------------------------------------------------------------

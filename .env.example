# Written for you by `npx convex dev` (development) — don't edit by hand.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Where HTTP routes live (CV uploads). Optional: derived from NEXT_PUBLIC_CONVEX_URL when empty.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public address of the website, used for canonical links, the sitemap and
# structured data. Optional on Vercel (it falls back to the vercel.app address);
# set it once your own domain is connected, e.g. https://scale-adv.com
NEXT_PUBLIC_SITE_URL=

# Video uploads (reels are stored on Cloudinary, never in Convex). From the
# Cloudinary console: Settings → API Keys. Fill these in here to upload while
# running the site locally. On the live site they're Vercel variables:
#   npx vercel env add CLOUDINARY_CLOUD_NAME production   (and the other two)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Set on Vercel only (not in this file):
#   CRON_SECRET        lets only Vercel Cron start the nightly video clean-up
#   CONVEX_DEPLOY_KEY  optional: production builds deploy Convex first
#
# Set on the Convex deployment (not in this file):
#   npx convex env set SETUP_KEY <long-random-string> --prod
# When SETUP_KEY is set, /admin/setup asks for it before creating the owner
# account. Recommended for production so nobody else can claim the dashboard.
# ---------------------------------------------------------------------------
